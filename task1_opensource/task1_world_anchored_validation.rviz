Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: map
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Alpha: 0.25
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Validation map
      Topic: /validation/safety_map
      Alpha: 0.85
      Color Scheme: map
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Global costmap
      Topic: /global_costmap/costmap
      Alpha: 0.35
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Local costmap
      Topic: /local_costmap/costmap
      Alpha: 0.35
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Active global path
      Topic: /task1/active_global_path
      Color: 255; 85; 0
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Planned route
      Topic: /task1/planned_route
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Frame Timeout: 15
      Marker Scale: 0.5
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot model
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Topic: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 35
      X: 0
      Y: 0
  Window Geometry:
    Height: 900
    Width: 1400
    X: 80
    Y: 60
